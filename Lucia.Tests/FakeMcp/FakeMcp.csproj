<Project Sdk="Microsoft.NET.Sdk">

  <!-- Un servidor MCP de mentira para las pruebas: habla JSON-RPC por stdio (initialize, tools/list,
       tools/call) con una herramienta «echo» que devuelve su argumento «text» en mayusculas, y «boom»
       que devuelve un error. FAKE_MCP_EXIT=N: sale con ese codigo sin hablar. FAKE_MCP_NOTOOLS: sin herramientas. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
