<Project Sdk="Microsoft.NET.Sdk">

  <!-- Un llama-server de mentira para las pruebas de la ventana: se queda vivo (o sale con
       FAKE_LLAMA_EXIT) y apunta sus argumentos en FAKE_LLAMA_LOG. Lo que contesta por HTTP lo
       pone el arnes de pruebas (un HttpClient de mentira en Downloader.Http). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
