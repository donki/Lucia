<Window x:Class="SocAiChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SocAiChat.Localization"
        Title="{loc:T AppTitle}"
        Width="1100" Height="760" MinWidth="720" MinHeight="480"
        Background="{DynamicResource PageBackground}">

    <!--
        Una sola pantalla: la lista de conversaciones a la izquierda y la conversacion a la
        derecha, con la barra de estado del motor debajo. Ajustes y «Acerca de» son ventanas
        aparte (botones con icono, constitucion 6).
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Conversaciones -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConversationsTitle" Style="{StaticResource CardTitle}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="NewChatButton" Style="{StaticResource IconButton}" Content="&#xE710;" Click="OnNewChat" />
                    <Button Grid.Column="2" x:Name="SettingsButton" Style="{StaticResource GhostIconButton}" Content="&#xE713;" Click="OnSettings" />
                    <Button Grid.Column="3" x:Name="AboutButton" Style="{StaticResource GhostIconButton}" Content="&#xE946;" Click="OnAbout" />
                </Grid>
                <ListBox x:Name="ThreadList" Background="Transparent" BorderThickness="0" Margin="6,0,6,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnThreadSelected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Primary}" />
                                                <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RenameMenu" Click="OnRenameThread" />
                            <MenuItem x:Name="DeleteMenu" Click="OnDeleteThread" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Conversacion -->
        <DockPanel Grid.Column="1">
            <!-- Estado del motor -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="16,6">
                <DockPanel>
                    <ProgressBar x:Name="EngineProgress" DockPanel.Dock="Right" Width="140" Height="6" Margin="12,0,0,0" Visibility="Collapsed"
                                 Foreground="{DynamicResource Primary}" Background="{DynamicResource Separator}" BorderThickness="0" />
                    <TextBlock x:Name="EngineStatus" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Redactor -->
            <Border DockPanel.Dock="Bottom" Padding="16,8,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" BorderBrush="{DynamicResource Separator}" BorderThickness="1" Padding="10,6">
                        <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                 PreviewKeyDown="OnComposerKey" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <Button x:Name="SendButton" Style="{StaticResource IconButton}" Content="&#xE724;" Width="44" Height="40" Click="OnSend" />
                        <Button x:Name="StopButton" Style="{StaticResource DangerIconButton}" Content="&#xE71A;" Width="44" Height="40" Click="OnStop" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Mensajes -->
            <Grid>
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel x:Name="Messages" MaxWidth="900" HorizontalAlignment="Stretch" />
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="24">
                    <Image x:Name="EmptyLogo" Width="72" Height="72" Margin="0,0,0,14" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource CardTitle}" FontSize="20" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
