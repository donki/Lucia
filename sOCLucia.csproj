<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SocLucia</RootNamespace>
    <AssemblyName>sOCLucia</AssemblyName>
    <ApplicationTitle>sOC Lucia</ApplicationTitle>
    <Version>2026.10.23.0</Version>
    <AssemblyVersion>2026.10.23.0</AssemblyVersion>
    <FileVersion>2026.10.23.0</FileVersion>
    <Product>sOC Lucia</Product>
    <Company>Socratic</Company>
    <Copyright>Copyright © 2026 Socratic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- La extension de VS Code (vscode\) y el paquete MSIX no son codigo .NET. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);vscode\**;Package\**;bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Las pruebas (Lucia.Tests) son otro proyecto: fuera de la compilacion de la app. -->
  <ItemGroup>
    <Compile Remove="Lucia.Tests\**" />
    <None Remove="Lucia.Tests\**" />
    <Page Remove="Lucia.Tests\**" />
    <EmbeddedResource Remove="Lucia.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- El script de entrenamiento va dentro del exe; PythonEnv lo escribe en finetune\ al usarlo. -->
    <EmbeddedResource Include="FineTune\lucia_train.py" LogicalName="SocLucia.FineTune.lucia_train.py" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lucia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
