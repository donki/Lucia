<Window x:Class="SocLucia.FineTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SocLucia.Controls"
        Width="720" Height="700" MinWidth="560" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">
    <!-- Enseñar a Lucia: asistente en cinco pasos (la IA, los ejemplos, como entrenar, entrenar, listo) -->
    <DockPanel Margin="16">
        <!-- Los pasos, arriba -->
        <StackPanel x:Name="StepBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" />

        <!-- Atras / siguiente, abajo -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource OutlineButton}" Click="OnBack" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="8,0,0,0" Click="OnClose" />
            <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Click="OnNext" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,10,0">

                <!-- 1. La IA que aprende -->
                <Border x:Name="Step1" Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <TextBlock x:Name="IntroTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="IntroText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="IntroHow" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="ModelLabel" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <ComboBox x:Name="ModelCombo" Style="{StaticResource DeviceCombo}" SelectionChanged="OnModelChanged" />
                        <c:BusyIndicator x:Name="ModelBusy" Margin="0,8,0,0" />
                        <TextBlock x:Name="BaseText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="FitText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="EnvText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 2. Los ejemplos -->
                <Border x:Name="Step2" Style="{StaticResource Card}" Padding="20,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ExamplesTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="ExamplesHint" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="FromChatsButton" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Click="OnFromChats" />
                            <Button x:Name="FromFileButton" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Click="OnFromFile" />
                            <Button x:Name="AddOneButton" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Click="OnAddOne" />
                            <Button x:Name="TemplateButton" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Click="OnTemplate" />
                        </WrapPanel>

                        <!-- Elegir conversaciones -->
                        <Border x:Name="ChatsBox" Visibility="Collapsed" BorderBrush="{DynamicResource Separator}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,8">
                            <StackPanel>
                                <TextBlock x:Name="ChatsHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <StackPanel x:Name="ChatsList" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ChatsAddButton" Style="{StaticResource OutlineButton}" Click="OnChatsAdd" />
                                    <Button x:Name="ChatsCancelButton" Style="{StaticResource GhostIconButton}" Content="&#xE711;" Margin="8,0,0,0" Click="OnChatsCancel" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Escribir un ejemplo -->
                        <Border x:Name="OneBox" Visibility="Collapsed" BorderBrush="{DynamicResource Separator}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,8">
                            <StackPanel>
                                <TextBlock x:Name="QuestionLabel" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox x:Name="QuestionBox" Style="{StaticResource Field}" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6" />
                                <TextBlock x:Name="AnswerLabel" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                <TextBox x:Name="AnswerBox" Style="{StaticResource Field}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="OneSaveButton" Style="{StaticResource OutlineButton}" Click="OnOneSave" />
                                    <Button x:Name="OneCancelButton" Style="{StaticResource GhostIconButton}" Content="&#xE711;" Margin="8,0,0,0" Click="OnOneCancel" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SystemLabel" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox x:Name="SystemBox" Style="{StaticResource Field}" Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6" />
                        <TextBlock x:Name="SystemHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <DockPanel Margin="0,14,0,4">
                            <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource DangerIconButton}" Content="&#xE74D;" Click="OnClearExamples" />
                            <TextBlock x:Name="ReviewText" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="ReviewHint" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                        <StackPanel x:Name="ExampleList" Margin="0,8,0,0" />
                        <TextBlock x:Name="MoreExamples" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. Como entrenar -->
                <Border x:Name="Step3" Style="{StaticResource Card}" Padding="20,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="PlanTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="PlanHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="QuickButton" Style="{StaticResource SegmentButton}" Click="OnPreset" />
                            <ToggleButton x:Name="BalancedButton" Style="{StaticResource SegmentButton}" Margin="6,0,0,0" Click="OnPreset" />
                            <ToggleButton x:Name="DeepButton" Style="{StaticResource SegmentButton}" Margin="6,0,0,0" Click="OnPreset" />
                        </StackPanel>
                        <TextBlock x:Name="PresetText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="NameLabel" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <TextBox x:Name="NameBox" Style="{StaticResource Field}" />
                        <TextBlock x:Name="NameHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="EstimateTitle" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <TextBlock x:Name="EstimateText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 4. Entrenar -->
                <Border x:Name="Step4" Style="{StaticResource Card}" Padding="20,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TrainTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="TrainHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button x:Name="StartButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Click="OnStart" />
                        <StackPanel x:Name="RunBox" Visibility="Collapsed" Margin="0,4,0,0">
                            <TextBlock x:Name="StageText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource DangerIconButton}" Content="&#xE711;" Width="30" Height="30" Margin="8,0,0,0" Click="OnCancel" />
                                <ProgressBar x:Name="TrainBar" Height="8" Foreground="{DynamicResource Primary}" Background="{DynamicResource Separator}" BorderThickness="0" />
                            </DockPanel>
                            <TextBlock x:Name="DetailText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="LossText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                        <Button x:Name="LogButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnOpenLog" />
                    </StackPanel>
                </Border>

                <!-- 5. Listo -->
                <Border x:Name="Step5" Style="{StaticResource Card}" Padding="20,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="DoneText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <CheckBox x:Name="UseCheck" Style="{StaticResource Check}" Margin="0,14,0,0" IsChecked="True" Click="OnUseChanged" />
                        <TextBlock x:Name="UseHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="22,2,0,0" />
                        <Button x:Name="TryButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnTry" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
